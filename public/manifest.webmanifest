{
  "id": "./",
  "name": "Gatecast",
  "short_name": "Gatecast",
  "description": "Cast your Human Design chart. In your browser. Nothing leaves it.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#0d0d1a",
  "theme_color": "#0d0d1a",
  "lang": "en",
  "dir": "ltr",
  "categories": ["lifestyle", "education"],
  "icons": [
    { "src": "./icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "./icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    {
      "src": "./icons/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    { "src": "./favicon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ],
  "screenshots": [
    {
      "src": "./screenshots/wide-1280x720.png",
      "sizes": "1280x720",
      "type": "image/png",
      "form_factor": "wide",
      "label": "A Human Design chart computed in the browser"
    },
    {
      "src": "./screenshots/narrow-750x1334.png",
      "sizes": "750x1334",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Gatecast on a phone"
    }
  ],
  "shortcuts": [
    {
      "name": "Compare charts",
      "short_name": "Compare",
      "url": "./#/compare",
      "icons": [{ "src": "./icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Library",
      "url": "./#/library",
      "icons": [{ "src": "./icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    }
  ]
}
